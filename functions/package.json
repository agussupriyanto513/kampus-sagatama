{
  "name": "kampus-sagatama-functions",
  "description": "Backend API kampus-sagatama — jembatan aman antara Pi Browser client dan portal-sagatama (SGT ledger pusat).",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,hosting",
